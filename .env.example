# Database
DATABASE_URL=postgresql+asyncpg://safecast:safecast_dev@localhost:5432/safecast_modern

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100000000  # 100MB

# Logging
LOG_LEVEL=INFO

# Dual Database Architecture
# PostgreSQL for main API (measurements, users, devices, bgeigie_imports)
DATABASE_URL=postgresql+asyncpg://safecast:safecast_dev@localhost:5432/safecast_modern

# Elasticsearch for real-time ingest data (device streams, air quality, radiation)
ELASTICSEARCH_URL=http://localhost:9200
